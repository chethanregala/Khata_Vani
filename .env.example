# Gnani (STT/TTS) — key from the Gnani AI console
GNANI_API_KEY=your_key_here
STT_LANG=indic-auto
TTS_VOICE=Nalini
TTS_LANG=te-IN
TTS_MODEL=timbre-v2.5
PORT=3000

# Supabase — Supabase dashboard -> Project Settings -> API
# (the service-role/secret key is server-only; never expose it to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
# SUPABASE_SECRET_KEY also works (Supabase's newer name for the same key)

# JWT_SECRET — any long random string, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
